# Copie este arquivo para .streamlit/secrets.toml e preencha com SEUS dados.
# NUNCA versione o secrets.toml. Os valores abaixo são apenas PLACEHOLDERS.

# 1) Conta de serviço (Firebase Admin SDK) - Console > Configurações do projeto > Contas de serviço
#    Os nomes dos campos são exatamente os do JSON baixado.
[firebase]
type = "service_account"
project_id = "SEU_PROJECT_ID"
private_key_id = "SEU_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_AQUI_MANTENDO_OS_\\n\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@SEU_PROJECT_ID.iam.gserviceaccount.com"
client_id = "SEU_CLIENT_ID"
token_uri = "https://oauth2.googleapis.com/token"

# 2) Chave de API da Web (pública, NÃO é senha administrativa)
#    Console > Configurações do projeto > Geral > "Chave de API da Web"
[firebase_web]
api_key = "SUA_WEB_API_KEY"
